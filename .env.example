# --- obrigatórias ------------------------------------------------------
# PAT com write:packages (push no GHCR) e repo (clonar e commitar no app-charts).
# `gh auth token` costuma ter os dois; o GITHUB_TOKEN do Actions, não.
GITHUB_TOKEN=
GITHUB_USER=juninmd
# Segredo do webhook, o MESMO configurado no GitHub. Gere com: openssl rand -hex 32
WEBHOOK_SECRET=
# Bearer exigido em /api/*. Gere com: openssl rand -hex 32
API_TOKEN=

# --- opcionais ---------------------------------------------------------
PORT=8080
REGISTRY=ghcr.io
REPOS_FILE=./repos.json
WORK_DIR=./data/work
LOG_DIR=./data/logs
POLL_INTERVAL_MS=3000
BUILD_TIMEOUT_MS=1200000
GIT_AUTHOR_NAME=ghcr-forge
GIT_AUTHOR_EMAIL=ghcr-forge@users.noreply.github.com
# URL pública, usada no link do log dentro do alerta de falha
PUBLIC_URL=

# --- notificação -------------------------------------------------------
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_IDS=
